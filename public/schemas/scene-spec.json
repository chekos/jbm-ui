        },
        "label": {
          "description": "Small caption above the value; translated.",
          "type": "string"
        },
        "value": {
          "description": "The figure itself, as display text (\"42 %\"); translated.",
          "type": "string"
        },
        "sub": {
          "description": "Optional line under the value; translated.",
          "type": "string"
        },
        "valueColor": {
          "description": "Value color.",
          "default": "accent",
          "type": "string",
          "enum": [
            "accent",
            "ink"
          ]
        }
      },
      "required": [
        "at",
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "SafeArea": {
      "title": "SafeArea",
      "description": "Canvas-pixel insets on a 1920 × 1080 (landscape) or 1080 × 1920 (vertical) composition. \"legacy\": landscape 90/120/160/120, vertical 100/72/480/72 (top/right/bottom/left). \"full\": landscape 90/120/90/120, vertical 100/72/100/72. \"social\": vertical 160/160/320/72; in landscape it falls back to \"full\". Custom insets must be nonnegative finite numbers that leave a positive content area.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "legacy",
            "full",
            "social"
          ]
        },
        {
          "type": "object",
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0
            },
            "right": {
              "type": "number",
              "minimum": 0
            },
            "bottom": {
              "type": "number",
              "minimum": 0
            },
            "left": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SceneLayout": {
      "title": "SceneLayout",
      "description": "\"flow\" stacks blocks top to bottom. \"hero\" centers the stack. \"headline-illustration\" takes exactly two blocks and no scene title (headline, then subject). \"illustration\" takes exactly one subject block and no scene title.",
      "type": "string",
      "enum": [
        "flow",
        "hero",
        "headline-illustration",
        "illustration"
      ]
    },
    "PerOrientation": {
      "title": "PerOrientation",
      "description": "A pixel value that can differ per orientation.",
      "type": "object",
      "properties": {
        "landscape": {
          "description": "Pixels on the 1920 × 1080 stage.",
          "type": "number",
          "minimum": 0
        },
        "vertical": {
          "description": "Pixels on the 1080 × 1920 stage.",
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "landscape",
        "vertical"
      ],
      "additionalProperties": false
    },
    "At": {
      "title": "At",
      "description": "A time. A number is seconds from scene start. A string is an anchor name, optionally followed by a signed offset in seconds: \"explain\", \"explain+0.2\", \"explain-0.5\". An anchor whose own name contains the offset text (e.g. \"my-cue-0.5\") matches exactly first.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\s*[\\w-]+?\\s*([+-]\\s*(\\d+(\\.\\d+)?|\\.\\d+))?\\s*$"
        },
        {
          "type": "number"
        }
      ]
    }
  }
